
name: Code Coverage

on:
  push:
  workflow_dispatch:

jobs:
  coverage:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install coverage
        run: pip install coverage

      - name: Run tests and measure coverage
        run: |
          coverage run --branch --source=shipping -m unittest discover -p "test_*.py"
          coverage report -m
          coverage xml

      - name: Send results to Coveralls
        uses: coverallsapp/github-action@v2
        with:
          file: coverage.xml
          format: cobertura
